# Docker local development environment variables
# Copy this file to .env.local and fill in your OAuth credentials.
# The DATABASE_URL is automatically configured by docker-compose for PostgreSQL.
# All other settings below are user-specific overrides.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change-me-to-a-random-32-char-secret
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Set automatically by docker-compose via the DATABASE_URL environment variable.
# Uncomment and adjust only if you need to override the compose.yaml default.
# DATABASE_URL="postgresql://app:!ChangeMe!@database:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> oauth ###
# Get credentials from https://console.cloud.google.com
# Authorized redirect URI: http://localhost:8080/connect/google/check
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Get credentials from https://github.com/settings/developers
# Authorization callback URL: http://localhost:8080/connect/github/check
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
###< oauth ###
