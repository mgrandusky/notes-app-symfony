{% extends 'base.html.twig' %}

{% block title %}{{ is_edit ? 'Edit Note' : 'New Note' }} - Notes App{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1>{{ is_edit ? 'Edit Note' : 'New Note' }}</h1>
            <a href="{{ path('app_notes_index') }}" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                {{ form_start(form) }}
                    <div class="mb-3">
                        {{ form_label(form.title, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                        {{ form_widget(form.title, {'attr': {'class': 'form-control form-control-lg'}}) }}
                        {{ form_errors(form.title) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(form.content, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                        {{ form_widget(form.content, {'attr': {'class': 'form-control', 'id': 'note-content'}}) }}
                        {{ form_errors(form.content) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(form.tags, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                        {{ form_widget(form.tags, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.tags) }}
                        <div class="form-text">Separate tags with commas, e.g.: work, ideas, important</div>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save"></i> {{ is_edit ? 'Save Changes' : 'Create Note' }}
                        </button>
                        <a href="{{ path('app_notes_index') }}" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{# Replace 'no-api-key' with your TinyMCE API key from https://www.tiny.cloud for production use #}
<script src="https://cdn.tiny.cloud/1/no-api-key/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>
<script>
    tinymce.init({
        selector: '#note-content',
        plugins: 'lists link code',
        toolbar: 'undo redo | formatselect | bold italic underline | bullist numlist | link | code',
        menubar: false,
        height: 400,
        promotion: false,
    });
</script>
{% endblock %}
